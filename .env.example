# SQLite for local development. For production use PostgreSQL (Neon/Supabase) — see README.
DATABASE_URL="file:./dev.db"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="replace-me"

# Web push (evening reminder). Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services — use your own email or site URL
VAPID_SUBJECT="mailto:you@example.com"

# Protects /api/cron/* — Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""
