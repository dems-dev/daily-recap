# SQLite for local development. For production use PostgreSQL (Neon/Supabase) — see README.
DATABASE_URL="file:./dev.db"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="replace-me"
# Needed when running `next start` yourself (local production, Docker, VPS).
# Not needed on Vercel, which is trusted automatically.
AUTH_TRUST_HOST="true"

# Web push (evening reminder). Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services — use your own email or site URL
VAPID_SUBJECT="mailto:you@example.com"

# Protects /api/cron/* — Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# AI features (Vercel AI Gateway via the AI SDK). Off unless a key is set.
# On Vercel the OIDC token is used automatically. Get a key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=""
# Optional model overrides ("provider/model" strings from https://ai-gateway.vercel.sh/v1/models)
# AI_FAST_MODEL="anthropic/claude-haiku-4.5"   # free-text logging, summaries
# AI_SMART_MODEL="anthropic/claude-sonnet-5"   # assistant (tool use), weekly coach
