# SQLite for local development. For production use PostgreSQL (Neon/Supabase) — see README.
DATABASE_URL="file:./dev.db"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="replace-me"
# Needed when running `next start` yourself (local production, Docker, VPS).
# Not needed on Vercel, which is trusted automatically.
AUTH_TRUST_HOST="true"

# Web push (evening reminder). Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services — use your own email or site URL
VAPID_SUBJECT="mailto:you@example.com"

# Protects /api/cron/* — Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# AI features (Google Gemini via the AI SDK's @ai-sdk/google). Off unless a key is set.
# Get a key at https://aistudio.google.com/apikey (free tier available; no card required).
# NOTE: on Gemini's FREE tier Google may use your prompts for training. The paid tier does not —
# prefer paid for an app that sends personal journal/finance/health data. Cost is tiny for one user.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional model overrides (Gemini model ids). Default: gemini-flash-lite-latest (fast, no "thinking").
# AI_FAST_MODEL="gemini-flash-lite-latest"   # free-text logging, summaries
# AI_SMART_MODEL="gemini-3.8-flash"          # assistant/coach: stronger reasoning, but slower (thinking model)
