generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  password     String
  avatar       String?
  locale       String   @default("id")
  currency     String   @default("IDR")
  timezone     String   @default("Asia/Jakarta")
  weekStartDay String   @default("monday")
  theme        String   @default("system")
  // Evening reminder (web push), sent at this local hour when the day's recap is empty
  reminderEnabled Boolean @default(false)
  reminderHour    Int     @default(20)
  lastReminderAt  DateTime?
  // User can turn AI features off; they only work when the server has AI configured too
  aiEnabled       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  finances         Finance[]
  budgets          Budget[]
  savingsGoals     SavingsGoal[]
  workouts         Workout[]
  meals            Meal[]
  sleepLogs        SleepLog[]
  waterLogs        WaterLog[]
  bodyMetrics      BodyMetric[]
  journals         Journal[]
  meditationLogs   MeditationLog[]
  todos            Todo[]
  habits           Habit[]
  goals            Goal[]
  pomodoroSessions PomodoroSession[]
  books            Book[]
  skills           Skill[]
  tilNotes         TilNote[]
  recurringTransactions RecurringTransaction[]
  pushSubscriptions     PushSubscription[]
  weeklyPriorities      WeeklyPriority[]
  wishlistItems         WishlistItem[]
}

model Finance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "income"|"expense"
  amount        Float
  category      String
  description   String?
  isRecurring   Boolean  @default(false)
  recurringType String?
  // Set when this row was generated from a recurring rule
  recurringId   String?
  recurring     RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, type, date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
}

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  icon          String?
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // GET /api/finance/savings: where { userId }
  @@index([userId])
}

model Workout {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  duration  Int?       // in minutes
  notes     String?
  date      DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  exercises Exercise[]

  // GET /api/workout: where { userId } orderBy date
  @@index([userId, date])
}

model Exercise {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      Json   // [{reps, weight, duration}]
  order     Int

  // Workout include: exercises (Postgres does not index FKs)
  @@index([workoutId])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "breakfast"|"lunch"|"dinner"|"snack"
  name      String
  calories  Int?
  protein   Float?
  carbs     Float?
  fat       Float?
  photo     String?
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GET /api/meals: where { userId, date }
  @@index([userId, date])
}

model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bedtime   DateTime // instant
  wakeTime  DateTime // instant
  duration  Int      // duration in minutes
  quality   Int      // 1-5
  notes     String?
  date      DateTime // calendar date of the morning you woke up
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  glasses   Int
  target    Int      @default(8)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float?
  bodyFat   Float?
  height    Float?
  notes     String?
  photo     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Journal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  mood      String   // "great"|"good"|"okay"|"bad"|"terrible"
  gratitude Json?
  tags      Json?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model MeditationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration  Int      // in minutes
  type      String   // "guided"|"breathing"|"silent"|"yoga"|"body-scan"
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GET /api/meditation: where { userId } orderBy date
  @@index([userId, date])
}

model Todo {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String?   // "high"|"medium"|"low"
  category    String?   // "work"|"personal"|"errands"
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  parentId    String?
  order       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, isCompleted, dueDate])
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  color     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  logs      HabitLog[]

  // loadDayRows / dayRecap / dashboard: where { userId, isActive }
  @@index([userId, isActive])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
  @@index([habitId, completed, date])
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String      // "health"|"finance"|"career"|"personal"|"learning"|"relationships"
  type        String      // "short-term"|"long-term"
  targetDate  DateTime?
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  milestones  Milestone[]

  // GET /api/goals: where { userId, isCompleted }
  @@index([userId, isCompleted])
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  order       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Goal include: milestones (Postgres does not index FKs)
  @@index([goalId])
}

model PomodoroSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // "work"|"study"|"side-project"|"creative"
  label       String?
  duration    Int      // in minutes
  isCompleted Boolean  @default(false)
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // dashboard + GET /api/pomodoro: where { userId, isCompleted, date }
  @@index([userId, isCompleted, date])
}

model Book {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  author      String?
  cover       String?
  totalPages  Int?
  currentPage Int       @default(0)
  status      String    // "want-to-read"|"reading"|"finished"
  rating      Int?
  review      String?
  quotes      Json?
  startDate   DateTime?
  finishDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // GET /api/books: where { userId, status? }
  @@index([userId, status])
}

model Skill {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  level     String         // "beginner"|"intermediate"|"advanced"
  resources Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sessions  SkillSession[]

  // GET /api/skills: where { userId } orderBy createdAt
  @@index([userId, createdAt])
}

model SkillSession {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  duration  Int      // in minutes
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Skill include: sessions (Postgres does not index FKs)
  @@index([skillId, date])
}

model TilNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  tags      Json?
  source    String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // GET /api/til: where { userId } orderBy date
  @@index([userId, date])
}

/// A rule that generates Finance rows (rent, subscriptions, salary...).
/// Rows are created lazily up to "today" whenever finance data is read.
model RecurringTransaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // "income"|"expense"
  amount      Float
  category    String
  description String?
  frequency   String    // "weekly"|"monthly"|"yearly"
  anchorDate  DateTime  // first occurrence; its day-of-month is kept for monthly/yearly
  nextDate    DateTime  // next occurrence not yet generated
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finances    Finance[]

  @@index([userId, isActive, nextDate])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  // reminders cron: where { userId }
  @@index([userId])
}

/// Up to a few priorities chosen for a week; checked off during the week and reviewed in the weekly recap.
model WeeklyPriority {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime  // calendar date of the first day of the week (per User.weekStartDay)
  title     String
  isDone    Boolean   @default(false)
  doneAt    DateTime?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, weekStart])
}

/// "Wait 7 days before buying": wanted purchases wait until waitUntil, then get bought or skipped.
model WishlistItem {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  category  String    // expense category key
  url       String?
  note      String?
  addedOn   DateTime  // calendar date
  waitUntil DateTime  // calendar date; decide on or after this day
  status    String    @default("waiting") // "waiting"|"bought"|"skipped"
  decidedOn DateTime? // calendar date
  financeId String?   // the expense created when bought
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, status])
}
