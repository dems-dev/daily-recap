generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  password     String
  avatar       String?
  locale       String   @default("id")
  currency     String   @default("IDR")
  timezone     String   @default("Asia/Jakarta")
  weekStartDay String   @default("monday")
  theme        String   @default("system")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  finances         Finance[]
  budgets          Budget[]
  savingsGoals     SavingsGoal[]
  workouts         Workout[]
  meals            Meal[]
  sleepLogs        SleepLog[]
  waterLogs        WaterLog[]
  bodyMetrics      BodyMetric[]
  journals         Journal[]
  meditationLogs   MeditationLog[]
  todos            Todo[]
  habits           Habit[]
  goals            Goal[]
  pomodoroSessions PomodoroSession[]
  books            Book[]
  skills           Skill[]
  tilNotes         TilNote[]
}

model Finance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "income"|"expense"
  amount        Float
  category      String
  description   String?
  isRecurring   Boolean  @default(false)
  recurringType String?
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
}

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  icon          String?
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Workout {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  duration  Int?       // in minutes
  notes     String?
  date      DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  exercises Exercise[]
}

model Exercise {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  sets      String   // JSON string: [{reps, weight, duration}]
  order     Int
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "breakfast"|"lunch"|"dinner"|"snack"
  name      String
  calories  Int?
  protein   Float?
  carbs     Float?
  fat       Float?
  photo     String?
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bedtime   DateTime
  wakeTime  DateTime
  duration  Int      // duration in minutes
  quality   Int      // 1-5
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  glasses   Int
  target    Int      @default(8)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float?
  bodyFat   Float?
  height    Float?
  notes     String?
  photo     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Journal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  mood      String   // "great"|"good"|"okay"|"bad"|"terrible"
  gratitude String?  // JSON string array
  tags      String?  // JSON string array
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model MeditationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration  Int      // in minutes
  type      String   // "guided"|"breathing"|"silent"|"yoga"|"body-scan"
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String?   // "high"|"medium"|"low"
  category    String?   // "work"|"personal"|"errands"
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime?
  parentId    String?
  order       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  color     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  logs      HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String      // "health"|"finance"|"career"|"personal"|"learning"|"relationships"
  type        String      // "short-term"|"long-term"
  targetDate  DateTime?
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  milestones  Milestone[]
}

model Milestone {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  order       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PomodoroSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // "work"|"study"|"side-project"|"creative"
  label       String?
  duration    Int      // in minutes
  isCompleted Boolean  @default(false)
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  author      String?
  cover       String?
  totalPages  Int?
  currentPage Int       @default(0)
  status      String    // "want-to-read"|"reading"|"finished"
  rating      Int?
  review      String?
  quotes      String?   // JSON string array
  startDate   DateTime?
  finishDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Skill {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  level     String         // "beginner"|"intermediate"|"advanced"
  resources String?        // JSON string array
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sessions  SkillSession[]
}

model SkillSession {
  id        String   @id @default(cuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  duration  Int      // in minutes
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TilNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  tags      String?  // JSON string array
  source    String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
